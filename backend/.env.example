# Shared local backend environment. Working directory: backend.
# Real secrets stay in .env (Git ignored); this file is read by all 8 apps.

# DataInit automatically fills missing initial data on every startup.
# No seed profile or extra environment variable is required. See ../docs/DATA-INIT.md.

# Ports
IDENTITY_SERVER_PORT=8081
BAKERY_SERVER_PORT=8082
MARKETPLACE_SERVER_PORT=8083
SUBSCRIPTION_SERVER_PORT=8084
CAKE_AI_SERVER_PORT=8085
ORDER_SERVER_PORT=8086
CHAT_SERVER_PORT=8087
API_GATEWAY_SERVER_PORT=8080

# PostgreSQL
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
IDENTITY_DB_USERNAME=postgres
IDENTITY_DB_PASSWORD=change-me
BAKERY_DB_URL=jdbc:postgresql://localhost:5432/bakery_db
BAKERY_DB_USERNAME=postgres
BAKERY_DB_PASSWORD=change-me
MARKETPLACE_DB_URL=jdbc:postgresql://localhost:5432/marketplace_db
MARKETPLACE_DB_USERNAME=postgres
MARKETPLACE_DB_PASSWORD=change-me
SUBSCRIPTION_DB_URL=jdbc:postgresql://localhost:5432/subscription_db
SUBSCRIPTION_DB_USERNAME=postgres
SUBSCRIPTION_DB_PASSWORD=change-me
CAKE_AI_DB_URL=jdbc:postgresql://localhost:5432/cake_ai_db
CAKE_AI_DB_USERNAME=postgres
CAKE_AI_DB_PASSWORD=change-me
ORDER_DB_URL=jdbc:postgresql://localhost:5432/order_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=change-me
CHAT_DB_URL=jdbc:postgresql://localhost:5432/chat_db
CHAT_DB_USERNAME=postgres
CHAT_DB_PASSWORD=change-me

# Service URLs
IDENTITY_SERVICE_URL=http://localhost:8081
SUBSCRIPTION_SERVICE_URL=http://localhost:8084
IDENTITY_SERVICE_BASE_URL=http://localhost:8081
BAKERY_SERVICE_BASE_URL=http://localhost:8082
SUBSCRIPTION_SERVICE_BASE_URL=http://localhost:8084
CAKE_AI_SERVICE_BASE_URL=http://localhost:8085
ORDER_SERVICE_BASE_URL=http://localhost:8086
MARKETPLACE_SERVICE_BASE_URL=http://localhost:8083
BAKERY_SERVICE_URL=http://localhost:8082
MARKETPLACE_SERVICE_URL=http://localhost:8083
CAKE_AI_SERVICE_URL=http://localhost:8085
ORDER_SERVICE_URL=http://localhost:8086
CHAT_SERVICE_URL=http://localhost:8087

# Identity JWT
IDENTITY_JWT_PRIVATE_KEY_PATH=identity-service/.keys/identity-private.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=identity-service/.keys/identity-public.pem
IDENTITY_JWT_ISSUER=bakery-platform-identity
IDENTITY_JWT_USER_AUDIENCE=bakery-platform-api
IDENTITY_REFRESH_COOKIE_SECURE=false
IDENTITY_JWKS_URI=http://localhost:8081/.well-known/jwks.json
IDENTITY_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# Internal service authentication
BAKERY_CLIENT_SECRET_HASH=replace-with-matching-bcrypt-hash
MARKETPLACE_CLIENT_SECRET_HASH=replace-with-matching-bcrypt-hash
SUBSCRIPTION_CLIENT_SECRET_HASH=replace-with-matching-bcrypt-hash
CAKE_AI_CLIENT_SECRET_HASH=replace-with-matching-bcrypt-hash
ORDER_CLIENT_SECRET_HASH=replace-with-matching-bcrypt-hash
CHAT_SERVICE_CLIENT_SECRET_HASH=replace-with-matching-bcrypt-hash
BAKERY_CLIENT_SECRET=replace-with-bakery-client-secret
BAKERY_IDENTITY_SERVICE_TOKEN=
SUBSCRIPTION_SERVICE_TOKEN=
MARKETPLACE_CLIENT_ID=marketplace-service
MARKETPLACE_CLIENT_SECRET=replace-with-marketplace-client-secret
SUBSCRIPTION_CLIENT_SECRET=replace-with-subscription-client-secret
SUBSCRIPTION_BAKERY_SERVICE_TOKEN=
CAKE_AI_CLIENT_ID=cake-ai-service
CAKE_AI_CLIENT_SECRET=replace-with-cake-ai-client-secret
ORDER_SERVICE_CLIENT_ID=order-service
ORDER_SERVICE_CLIENT_SECRET=replace-with-order-service-client-secret
CHAT_SERVICE_CLIENT_ID=chat-service
CHAT_SERVICE_CLIENT_SECRET=replace-with-chat-service-client-secret

# VNPay Sandbox
SUBSCRIPTION_VNPAY_ENABLED=false
SUBSCRIPTION_VNPAY_TMN_CODE=
SUBSCRIPTION_VNPAY_HASH_SECRET=
SUBSCRIPTION_VNPAY_RETURN_URL=http://localhost:5173/subscription-vnpay-return

# Firebase
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_STORAGE_BUCKET=replace-with-bucket.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
CAKE_AI_FIREBASE_PROJECT_ID=replace-with-project-id
CAKE_AI_FIREBASE_BUCKET=replace-with-bucket.firebasestorage.app

# Object storage
BAKERY_MINIO_ENDPOINT=http://localhost:9000
BAKERY_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
BAKERY_MINIO_ACCESS_KEY=S3RVER
BAKERY_MINIO_SECRET_KEY=S3RVER
BAKERY_MINIO_BUCKET=bakery-media
SUBSCRIPTION_MINIO_ENDPOINT=http://localhost:9000
SUBSCRIPTION_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
SUBSCRIPTION_MINIO_ACCESS_KEY=S3RVER
SUBSCRIPTION_MINIO_SECRET_KEY=S3RVER
SUBSCRIPTION_MINIO_BUCKET=subscription-proofs
CHAT_STORAGE_ENDPOINT=http://localhost:9000
CHAT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
CHAT_STORAGE_ACCESS_KEY=S3RVER
CHAT_STORAGE_SECRET_KEY=S3RVER
CHAT_STORAGE_BUCKET=chat-attachments

# Cake AI and background tasks
MARKETPLACE_ORPHAN_CLEANUP_ENABLED=false
CAKE_AI_API_KEY=
CAKE_AI_ENABLED=false
CAKE_AI_SCHEDULER_ENABLED=false
CAKE_AI_CLEANUP_ENABLED=false
