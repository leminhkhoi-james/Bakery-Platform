IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
IDENTITY_DB_USERNAME=postgres
IDENTITY_DB_PASSWORD=change-me
IDENTITY_JWT_PRIVATE_KEY_PATH=C:/path/to/identity-private.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=C:/path/to/identity-public.pem
IDENTITY_JWT_ISSUER=bakery-platform-identity
IDENTITY_JWT_USER_AUDIENCE=bakery-platform-api
IDENTITY_REFRESH_COOKIE_SECURE=false
