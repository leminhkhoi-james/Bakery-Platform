# Copy to .env.docker at the repository root. Local development only.
# Compose reads this file via --env-file, independently of each module's .env.
BAKERY_DB_USERNAME=postgres
BAKERY_DB_PASSWORD=postgres
SUBSCRIPTION_DB_USERNAME=postgres
SUBSCRIPTION_DB_PASSWORD=postgres
BAKERY_MINIO_ACCESS_KEY=minioadmin
BAKERY_MINIO_SECRET_KEY=minioadmin
SUBSCRIPTION_MINIO_ACCESS_KEY=minioadmin
SUBSCRIPTION_MINIO_SECRET_KEY=minioadmin
BAKERY_MINIO_PUBLIC_ENDPOINT=http://localhost:9002
SUBSCRIPTION_MINIO_PUBLIC_ENDPOINT=http://localhost:9004
STORAGE_MINIO_REGION=us-east-1

# Root compose.yaml exposes Identity on host port 8081. Keep its JWT issuer.
IDENTITY_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
IDENTITY_SERVICE_URL=http://host.docker.internal:8081
IDENTITY_JWT_ISSUER=bakery-platform-identity
IDENTITY_JWT_USER_AUDIENCE=bakery-platform-api

# Supply scoped service JWTs when Identity supports issuing them.
BAKERY_IDENTITY_SERVICE_TOKEN=
SUBSCRIPTION_SERVICE_TOKEN=
SUBSCRIPTION_BAKERY_SERVICE_TOKEN=
BAKERY_CLIENT_SECRET=
SUBSCRIPTION_CLIENT_SECRET=
