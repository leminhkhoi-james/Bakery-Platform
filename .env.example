# Copy to .env. Use forward slashes in absolute Windows paths.
IDENTITY_DB_USERNAME=identity
IDENTITY_DB_PASSWORD=replace-with-local-db-password
MARKETPLACE_DB_USERNAME=marketplace
MARKETPLACE_DB_PASSWORD=replace-with-another-local-db-password
IDENTITY_JWT_PRIVATE_KEY_FILE=C:/Users/lemin/.secrets/bakery-platform/identity-private.pem
IDENTITY_JWT_PUBLIC_KEY_FILE=C:/Users/lemin/.secrets/bakery-platform/identity-public.pem
FIREBASE_CREDENTIALS_FILE=C:/Users/lemin/.secrets/bakery-platform/marketplace-storage-dev.json
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_STORAGE_BUCKET=replace-with-bucket-name.firebasestorage.app
MARKETPLACE_CLIENT_SECRET=replace-with-random-service-secret
# Paste BCrypt hash of MARKETPLACE_CLIENT_SECRET between single quotes (preserve $).
MARKETPLACE_CLIENT_SECRET_HASH='replace-with-bcrypt-hash'
# Paste BCrypt hash of ORDER_SERVICE_CLIENT_SECRET here (preserve $); Identity stores only this hash.
ORDER_CLIENT_SECRET_HASH='replace-with-bcrypt-hash'
ORDER_SERVICE_CLIENT_SECRET=replace-with-another-random-service-secret
# Chat uses a separate client secret; Identity receives only its BCrypt hash.
CHAT_SERVICE_CLIENT_SECRET=replace-with-another-random-service-secret
CHAT_SERVICE_CLIENT_SECRET_HASH='replace-with-bcrypt-hash'
MARKETPLACE_SERVICE_PORT=8082
BAKERY_SERVICE_BASE_URL=http://host.docker.internal:8083
SUBSCRIPTION_SERVICE_BASE_URL=http://host.docker.internal:8084
CAKE_AI_SERVICE_BASE_URL=http://host.docker.internal:8085
ORDER_SERVICE_BASE_URL=http://host.docker.internal:8086
